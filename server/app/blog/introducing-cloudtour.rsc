3:[["$","p",null,{"children":"Virtual tours have been stuck in the panorama era for too long. Stitched 360-degree photos feel flat, lifeless, and disconnected from the spaces they try to represent. We knew there had to be a better way."}],"\n",["$","h2",null,{"children":"The Problem with Traditional Virtual Tours"}],"\n",["$","p",null,{"children":"Traditional virtual tour platforms rely on equirectangular panoramas — essentially flat images wrapped around a sphere. They work, but they strip away the depth and dimensionality that makes a space feel real."}],"\n",["$","p",null,{"children":["You can look around, but you can't truly ",["$","em",null,{"children":"explore"}],". The geometry is an illusion."]}],"\n",["$","h2",null,{"children":"Enter Gaussian Splatting"}],"\n",["$","p",null,{"children":"Gaussian splatting is a breakthrough in 3D scene reconstruction. Instead of meshes or point clouds, it represents scenes as collections of 3D Gaussians — volumetric elements that capture lighting, color, and transparency with photorealistic fidelity."}],"\n",["$","p",null,{"children":"The result? Scenes that feel genuinely three-dimensional. You can orbit, zoom, and explore from angles the original photographer never captured."}],"\n",["$","h2",null,{"children":"What CloudTour Offers"}],"\n",["$","p",null,{"children":"With CloudTour, you can:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Upload splat files"}]," (.ply, .splat, .spz) captured from real-world scenes"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Build multi-scene tours"}]," with waypoints connecting different spaces"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Add hotspots"}]," with rich content — text, images, and more"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Share publicly"}]," with SEO-optimized pages and embeddable viewers"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"View in Apple Vision Pro"}]," via WebXR for true spatial computing"]}],"\n"]}],"\n",["$","h2",null,{"children":"Built for Creators"}],"\n",["$","p",null,{"children":"Whether you're a real estate agent showcasing properties, a museum curator digitizing exhibits, or a tourism board promoting destinations — CloudTour gives you the tools to create experiences that do your spaces justice."}],"\n",["$","p",null,{"children":[["$","a",null,{"href":"/signup","children":"Get started for free"}]," and create your first spatial tour today."]}]]
8:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"Introducing CloudTour: Spatial Tours for the Places Worth Remembering — CloudTour"}],["$","meta","3",{"name":"description","content":"We're launching CloudTour — a platform that lets you create immersive 3D virtual tours using Gaussian splatting technology. Here's why we built it."}],["$","meta","4",{"property":"og:title","content":"Introducing CloudTour: Spatial Tours for the Places Worth Remembering — CloudTour Blog"}],["$","meta","5",{"property":"og:description","content":"We're launching CloudTour — a platform that lets you create immersive 3D virtual tours using Gaussian splatting technology. Here's why we built it."}],["$","meta","6",{"property":"og:url","content":"https://cloudtour.app/blog/introducing-cloudtour"}],["$","meta","7",{"property":"og:type","content":"article"}],["$","meta","8",{"property":"article:published_time","content":"2026-03-01"}],["$","meta","9",{"property":"article:author","content":"CloudTour Team"}],["$","meta","10",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","11",{"name":"twitter:title","content":"Introducing CloudTour: Spatial Tours for the Places Worth Remembering — CloudTour Blog"}],["$","meta","12",{"name":"twitter:description","content":"We're launching CloudTour — a platform that lets you create immersive 3D virtual tours using Gaussian splatting technology. Here's why we built it."}]]
