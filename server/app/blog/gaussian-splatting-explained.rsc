3:[["$","p",null,{"children":"If you've seen a CloudTour experience and wondered how it looks so lifelike, the answer is Gaussian splatting. Let's break down what it is and why it matters."}],"\n",["$","h2",null,{"children":"What Is Gaussian Splatting?"}],"\n",["$","p",null,{"children":"At its core, Gaussian splatting (formally \"3D Gaussian Splatting for Real-Time Radiance Field Rendering\") is a technique for reconstructing 3D scenes from photographs. It was introduced in 2023 and quickly became one of the most exciting developments in computer graphics."}],"\n",["$","p",null,{"children":"Instead of traditional polygon meshes, the scene is represented as millions of tiny 3D Gaussians — think of them as soft, colored blobs in space. Each Gaussian has:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":["A ",["$","strong",null,{"children":"position"}]," in 3D space"]}],"\n",["$","li",null,{"children":["A ",["$","strong",null,{"children":"color"}]," (with view-dependent effects)"]}],"\n",["$","li",null,{"children":["An ",["$","strong",null,{"children":"opacity"}]," value"]}],"\n",["$","li",null,{"children":["A ",["$","strong",null,{"children":"covariance matrix"}]," defining its shape and orientation"]}],"\n"]}],"\n",["$","h2",null,{"children":"Why Not NeRF?"}],"\n",["$","p",null,{"children":"Neural Radiance Fields (NeRF) pioneered photorealistic novel view synthesis, but they come with drawbacks:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Slow rendering"}]," — NeRFs require expensive ray marching"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Long training times"}]," — hours to days per scene"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Hard to edit"}]," — the scene is locked inside a neural network"]}],"\n"]}],"\n",["$","p",null,{"children":"Gaussian splatting solves all three:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Real-time rendering"}]," at 30+ FPS using rasterization"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Training in minutes"}]," on a consumer GPU"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Explicit representation"}]," — you can edit, merge, and manipulate individual Gaussians"]}],"\n"]}],"\n",["$","h2",null,{"children":"File Formats We Support"}],"\n",["$","p",null,{"children":"CloudTour supports the three most common Gaussian splat formats:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"PLY"}]," — the original format from the research paper"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"SPLAT"}]," — a compact binary format optimized for web delivery"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"SPZ"}]," — a compressed format for even smaller file sizes"]}],"\n"]}],"\n",["$","h2",null,{"children":"The Future"}],"\n",["$","p",null,{"children":"Gaussian splatting is evolving rapidly. Dynamic scenes, relightable splatting, and higher compression ratios are all active areas of research. CloudTour is built to support these advances as they mature."}],"\n",["$","p",null,{"children":["Want to try it yourself? ",["$","a",null,{"href":"/signup","children":"Create a free account"}]," and upload your first splat file."]}]]
