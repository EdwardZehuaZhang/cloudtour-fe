ldren":"Row-level security (RLS) on all database tables"}],["$","li",null,{"children":"JWT-based authentication with secure session management"}],["$","li",null,{"children":"Stripe-verified webhook signatures for payment processing"}],["$","li",null,{"children":"Rate limiting on all API endpoints"}],["$","li",null,{"children":"Magic byte validation for file uploads (not file extension trust)"}]]}]]}]]}],["$","section",null,{"className":"mb-10","children":[["$","h2",null,{"className":"font-display text-xl font-normal text-text-primary mb-3","children":"9. Cookies"}],["$","div",null,{"className":"space-y-3 text-sm leading-relaxed text-text-secondary","children":["$","p",null,{"children":"We use essential cookies for authentication and session management. We do not use advertising or tracking cookies. Authentication cookies are strictly necessary for the platform to function and do not require separate consent."}]}]]}],["$","section",null,{"className":"mb-10","children":[["$","h2",null,{"className":"font-display text-xl font-normal text-text-primary mb-3","children":"10. Children's Privacy"}],["$","div",null,{"className":"space-y-3 text-sm leading-relaxed text-text-secondary","children":["$","p",null,{"children":"CloudTour is not directed at children under 16. We do not knowingly collect personal data from children. If you believe we have collected data from a child, please contact us at privacy@cloudtour.app and we will promptly delete it."}]}]]}],["$","section",null,{"className":"mb-10","children":[["$","h2",null,{"className":"font-display text-xl font-normal text-text-primary mb-3","children":"11. Changes to This Policy"}],["$","div",null,{"className":"space-y-3 text-sm leading-relaxed text-text-secondary","children":["$","p",null,{"children":"We may update this privacy policy from time to time. We will notify you of material changes by email or by posting a notice on the platform. Your continued use of CloudTour after changes constitutes acceptance of the updated p